<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Post-splash app theme (the window switches to this after the system splash). -->
    <style name="Theme.Bubbles" parent="@android:style/Theme.DeviceDefault.NoActionBar" />

    <!-- System splash: covers tap -> first Compose frame with the launcher mark on
         black, then hands off to Theme.Bubbles (whose first frame is the SplashCard). -->
    <style name="Theme.Bubbles.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bubbles</item>
    </style>
</resources>
